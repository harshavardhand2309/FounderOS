# Firebase config for auth + waitlist. Copy this file to `.env` and fill in the
# values from your Firebase project (Project settings → Your apps → Web app).
# These are client-side keys and are safe to expose. Leave them blank to keep
# the site in mock mode (auth UI works but sends nothing).
#
# After setting these, also enable Email/Password + Phone + Google + Apple in
# Firebase Auth, add your domains to Auth → Settings → Authorized domains, and
# create a Firestore "waitlist" collection. See src/utils/firebase.js.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
