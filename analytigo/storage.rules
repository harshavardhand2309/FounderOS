rules_version = '2';

// Cloud Storage rules for Lvl-Up Sports.
//
// Deploy with:  firebase deploy --only storage
//
// Only one thing is uploaded from the public site today: a CV attached to a job
// application (src/utils/firebase.js → submitApplication). Applicants are not
// signed in, so the default "auth required" rules would reject every upload —
// but an unrestricted bucket is an open file drop. These rules take the middle
// path: anonymous *create* into one prefix only, capped by size and MIME type,
// and no read access from the client at all.
//
// Note: submitApplication currently calls getDownloadURL() straight after the
// upload, which needs read on the object. Rather than granting public read on
// resumes, read the file from the Firebase console (or a Cloud Function using
// the Admin SDK, which bypasses these rules). See the note in the go-live guide.

service firebase.storage {
  match /b/{bucket}/o {

    // Job application CVs — write-once, never listed or read by clients.
    match /resumes/{roleId}/{fileName} {
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches(
                         'application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                       );
      allow read, update, delete: if false;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
